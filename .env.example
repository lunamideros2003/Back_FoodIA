# ---- Server ----
# Most hosting platforms assign PORT automatically. Only set it by hand locally.
PORT=4000
NODE_ENV=development

# ---- Database ----
# Two options, chosen with DATABASE_URL:
#
# 1. Empty DATABASE_URL (development / tests): SQLite in a single file. Zero
#    config. On a hosted platform without a mounted volume the file is erased
#    on every deploy, so it is NOT the right choice for production.
DATABASE_FILE=./data/foodmood.db
#
# 2. DATABASE_URL set (production): Postgres, for example Supabase. The backend
#    creates all the tables and seeds the 40 dishes on first boot.
#    Use the "Session Pooler" connection string that Supabase shows, because
#    Render may not have outbound IPv6:
#    DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#    DATABASE_SSL=false only for a local Postgres without TLS.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_TIMEOUT_MS=30000

# ---- Frontend allowed origins (CORS) ----
# Separate several with commas. In production add the deployed frontend URL,
# for example https://fron-food-ia.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---- AI layer ----
# Leave AI_PROVIDER=local to run fully offline (deterministic narrative generator).
# AI_PROVIDER=openai uses OpenAI (models like gpt-4o-mini).
# AI_PROVIDER=groq uses Groq, free and OpenAI-compatible, with models like
# llama-3.3-70b-versatile: create the API key on https://console.groq.com.
# Each provider brings its own default base URL and model; only set them by hand
# if you want to override, for example AI_MODEL=llama-3.1-8b-instant.
AI_PROVIDER=local
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# How long the "Cocinar conmigo" assistant waits before falling back to the
# local answers. Keep it short: the person is standing in front of the stove.
AI_ASSISTANT_TIMEOUT_MS=9000

# ---- gRPC ----
# Native HTTP/2 gRPC endpoint (FoodMoodStatus). Same machine, separate port,
# the REST API never depends on it. Set GRPC_PORT=0 to turn the layer off.
GRPC_PORT=4002

# ---- Recommender tuning ----
RECENT_INTERACTION_LIMIT=40
