# ---- Server ----
# Most hosting platforms assign PORT automatically. Only set it by hand locally.
PORT=4000
NODE_ENV=development

# ---- Database ----
# SQLite file path. Easiest possible database: zero config, single file.
# On a hosted platform this MUST point at the mounted volume (usually /data),
# otherwise the database is erased on every deploy.
DATABASE_FILE=./data/foodmood.db

# ---- Frontend allowed origins (CORS) ----
# Separate several with commas. In production add the deployed frontend URL,
# for example https://foodmood-ia.vercel.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---- AI layer ----
# Leave AI_PROVIDER=local to run fully offline (deterministic narrative generator).
# AI_PROVIDER=openai uses OpenAI (models like gpt-4o-mini).
# AI_PROVIDER=groq uses Groq, free and OpenAI-compatible, with models like
# llama-3.3-70b-versatile: create the API key on https://console.groq.com.
# Each provider brings its own default base URL and model; only set them by hand
# if you want to override, for example AI_MODEL=llama-3.1-8b-instant.
AI_PROVIDER=local
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# How long the "Cocinar conmigo" assistant waits before falling back to the
# local answers. Keep it short: the person is standing in front of the stove.
AI_ASSISTANT_TIMEOUT_MS=9000

# ---- Recommender tuning ----
RECENT_INTERACTION_LIMIT=40
