{
  "name": "foodmood-ia-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FoodMood IA - Mood-aware food recommendation API (AI engine: TF-IDF content ranking + collaborative filtering + LLM narrative layer)",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "seed": "node --experimental-strip-types src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
